# Backend Environment Variables
# Copy this file to .env and fill in real values

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/photography_db?retryWrites=true&w=majority

# JWT Secret (change this to a strong random 64-character string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_64chars_minimum

# Port
PORT=5001

# Node Environment
NODE_ENV=production
